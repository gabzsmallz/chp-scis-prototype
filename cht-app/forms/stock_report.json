{
    "type": "form",
    "_id": "form:stock_report",
    "internalId": "stock_report",
    "title": "Monthly Stock Report",
    "icon": "icon-healthcare-medicine",
    "context": {
          "person": false,
          "place": false,
          "expression": "user.role === 'chp'"
    },
    "fields": {
          "inputs": {
                  "type": "group",
                  "appearance": "hidden",
                  "fields": {
                            "meta": {
                                        "type": "group",
                                        "fields": {
                                                      "location": { "type": "db-object", "map": "contact" }
                                        }
                            }
                  }
          },
          "group_medicines": {
                  "type": "group",
                  "label": "Medicines",
                  "appearance": "field-list",
                  "fields": {
                            "amoxicillin_stock": {
                                        "type": "integer",
                                        "label": "Amoxicillin 250mg tabs — current stock (units)",
                                        "hint": "Enter the number of individual tablets remaining",
                                        "required": true,
                                        "constraint": ". >= 0",
                                        "constraint_message": "Value must be 0 or more"
                            },
                            "ors_stock": {
                                        "type": "integer",
                                        "label": "ORS sachets — current stock (sachets)",
                                        "required": true,
                                        "constraint": ". >= 0"
                            },
                            "zinc_stock": {
                                        "type": "integer",
                                        "label": "Zinc sulfate 20mg tabs — current stock (units)",
                                        "required": true,
                                        "constraint": ". >= 0"
                            },
                            "rdt_stock": {
                                        "type": "integer",
                                        "label": "Malaria RDTs — current stock (tests)",
                                        "required": true,
                                        "constraint": ". >= 0"
                            }
                  }
          },
          "group_fp": {
                  "type": "group",
                  "label": "Family Planning Commodities",
                  "appearance": "field-list",
                  "fields": {
                            "fp_pills_stock": {
                                        "type": "integer",
                                        "label": "Combined OCP — current stock (cycles)",
                                        "required": true,
                                        "constraint": ". >= 0"
                            },
                            "fp_injectables_stock": {
                                        "type": "integer",
                                        "label": "DMPA injectables — current stock (vials)",
                                        "required": true,
                                        "constraint": ". >= 0"
                            }
                  }
          },
          "group_notes": {
                  "type": "group",
                  "label": "Additional Notes",
                  "fields": {
                            "notes": {
                                        "type": "text",
                                        "label": "Any stockout reasons or comments?",
                                        "required": false
                            }
                  }
          },
          "summary": {
                  "type": "group",
                  "label": "Summary",
                  "appearance": "summary",
                  "fields": {
                            "amoxicillin_alert": {
                                        "type": "note",
                                        "label": "⚠️ Amoxicillin LOW — please request resupply",
                                        "relevant": "amoxicillin_stock <= 10"
                            },
                            "ors_alert": {
                                        "type": "note",
                                        "label": "⚠️ ORS LOW — please request resupply",
                                        "relevant": "ors_stock <= 5"
                            },
                            "zinc_alert": {
                                        "type": "note",
                                        "label": "⚠️ Zinc LOW — please request resupply",
                                        "relevant": "zinc_stock <= 10"
                            },
                            "rdt_alert": {
                                        "type": "note",
                                        "label": "⚠️ RDT LOW — please request resupply",
                                        "relevant": "rdt_stock <= 5"
                            },
                            "fp_pills_alert": {
                                        "type": "note",
                                        "label": "⚠️ OCP LOW — please request resupply",
                                        "relevant": "fp_pills_stock <= 3"
                            },
                            "fp_injectables_alert": {
                                        "type": "note",
                                        "label": "⚠️ DMPA LOW — please request resupply",
                                        "relevant": "fp_injectables_stock <= 2"
                            }
                  }
          }
    },
    "actions": [
          {
                  "type": "report",
                  "form": "stock_report"
          }
    ]
}
